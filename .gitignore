# Environment
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/

# Local secrets / personal config
.env
*.local.yml

# OS noise
.DS_Store

# Cached raw filing downloads (large, reproducible from data/sources.csv + fetch)
data/raw/*
!data/raw/.gitkeep

# Derived SQLite databases (regenerated by `normalize`; not source of truth)
*.db
*.sqlite
*.sqlite3

# Generated workbook / report artifacts (regenerated by export commands)
outputs/excel/*.xlsx
outputs/reporting/*.csv
!outputs/excel/.gitkeep
!outputs/reporting/.gitkeep
